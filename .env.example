# Optional live WGUI encounter projection endpoint.
# When unset, the extension runs with sample data so the UI can be developed independently.
VITE_WGUI_ENCOUNTER_URL=

# Optional identifiers sent to the encounter projection endpoint.
VITE_WGUI_CAMPAIGN_ID=
VITE_WGUI_FIGHT_ID=

# Optional bearer token for development only. Do not commit real credentials.
VITE_WGUI_BEARER_TOKEN=

# Poll interval while the panel is open.
VITE_WGUI_POLL_MS=5000
