# This extension runs at http://localhost:5201. Backend is chosen from that host, not from the variables below.
# localhost / 127.0.0.1 / *.localhost -> Wanderer's Guide at http://localhost:5194 and API at http://localhost:8000
# any other host (Owlbear, pages.dev) -> https://wgui.wandersguide.site and https://amba.wandersguide.site
# Connect opens the small handoff page on that Wanderer's Guide origin. It does not open the login page.

# Set both to an empty string to disable the live Supabase client (tests / HTTP adapters).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional alternate HTTP adapters. Leave blank when using the Supabase/WGUI functions above.
VITE_WGUI_CAMPAIGNS_URL=
VITE_WGUI_ENCOUNTERS_URL=
VITE_WGUI_ENCOUNTER_URL=

# Poll interval while the selected encounter is open.
VITE_WGUI_POLL_MS=5000
