# This extension is locked to local Wanderer's Guide.
# App: http://localhost:5194. Shared WG API (Kong): http://localhost:8000.
# Connect opens the small handoff page on 5194. It does not open the login page.

# Set both to an empty string to disable the live Supabase client (tests / HTTP adapters).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional alternate HTTP adapters. Leave blank when using the Supabase/WGUI functions above.
VITE_WGUI_CAMPAIGNS_URL=
VITE_WGUI_ENCOUNTERS_URL=
VITE_WGUI_ENCOUNTER_URL=

# Poll interval while the selected encounter is open.
VITE_WGUI_POLL_MS=5000
