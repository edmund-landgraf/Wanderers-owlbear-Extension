# local = Windows. Original UI http://localhost:5193, reskin http://localhost:5194,
#         shared WG API (Kong) http://localhost:8000. Sign-in opens the reskin.
# prod = Linux. amba.wandersguide.site (original UI) and wgui.wandersguide.site (reskin)
#        are the same machine and the same WG instance. Sign-in opens the reskin.
# Dev builds default to local. Production builds default to prod.
# The extension also has a Local / Production switch that overrides this.
VITE_WGUI_TARGET=

# Set both to an empty string to disable the live Supabase client (tests / HTTP adapters).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional alternate HTTP adapters. Leave blank when using the Supabase/WGUI functions above.
VITE_WGUI_CAMPAIGNS_URL=
VITE_WGUI_ENCOUNTERS_URL=
VITE_WGUI_ENCOUNTER_URL=

# Poll interval while the selected encounter is open.
VITE_WGUI_POLL_MS=5000
